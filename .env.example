# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InkEcho

# Database
DATABASE_URL=mongodb://localhost:27017/inkecho?replicaSet=rs0

# Auth (Better Auth)
BETTER_AUTH_SECRET=changeme_at_least_32_chars_long_random_secret_string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Guest Sessions
GUEST_SESSION_SECRET=changeme_at_least_32_chars_long_random_secret_string
GUEST_SESSION_TTL_HOURS=24

# Ably Realtime
ABLY_API_KEY=dummy:dummy
ABLY_TOKEN_TTL_SECONDS=3600

# Cloudinary
CLOUDINARY_CLOUD_NAME=inkecho
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy
CLOUDINARY_UPLOAD_FOLDER=inkecho/dev/drawings

# Monitoring & Logging
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron & Internal
CRON_SECRET=changeme_cron_secret_string_32_chars_long

# Feature Flags
NEXT_PUBLIC_ENABLE_PUBLIC_ROOMS=true
NEXT_PUBLIC_ENABLE_VOTING=true
NEXT_PUBLIC_ENABLE_OAUTH=true
